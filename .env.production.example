# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production and fill in your actual values
# Never commit .env.production to version control
#
# Required variables are marked with [REQUIRED]
# Optional variables are marked with [OPTIONAL]
# =============================================================================

# -----------------------------------------------------------------------------
# Email Service Configuration
# -----------------------------------------------------------------------------
# Primary email provider: Resend (https://resend.com)
# High deliverability email API for transactional emails
# Get your API key from: https://resend.com/api-keys
# [REQUIRED if using Resend as primary provider]
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backup email provider: SendGrid (https://sendgrid.com)
# Enterprise email delivery service
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# [OPTIONAL - recommended as backup]
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback email provider: Formspree (https://formspree.io)
# Simple form backend service
# Get your endpoint from: https://formspree.io/forms
# [OPTIONAL - recommended as last resort fallback]
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Email sender address
# Must be a verified domain with your email provider
# Format: "Name <email@domain.com>" or just "email@domain.com"
# [REQUIRED]
EMAIL_FROM=noreply@yourdomain.com

# Sales team email address
# Where demo requests and contact form submissions are sent
# [REQUIRED]
SALES_EMAIL=sales@yourdomain.com

# -----------------------------------------------------------------------------
# Analytics & Monitoring
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
# Get your Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
# [OPTIONAL - recommended for tracking]
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN (Data Source Name)
# Error tracking and performance monitoring
# Get your DSN from: https://sentry.io/settings/projects/
# [OPTIONAL - recommended for production error tracking]
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000

# Sentry Environment
# Helps distinguish errors by deployment environment
# [OPTIONAL]
SENTRY_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Security & CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated list)
# Include all domains that should be allowed to make API requests
# Production domain, www subdomain, and any CDN domains
# [REQUIRED]
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Node environment (should always be "production" in production)
# [REQUIRED]
NODE_ENV=production

# Application URL (used for generating absolute URLs in emails, etc.)
# [REQUIRED]
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# Rate Limiting & Security
# -----------------------------------------------------------------------------
# Maximum requests per IP address per minute (for form submissions)
# [OPTIONAL - defaults to 5 if not set]
RATE_LIMIT_MAX=5

# Rate limit window in milliseconds
# [OPTIONAL - defaults to 60000 (1 minute) if not set]
RATE_LIMIT_WINDOW=60000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable features without code changes
# Set to "true" or "false"
# [OPTIONAL]

# Enable newsletter signup form
NEXT_PUBLIC_ENABLE_NEWSLETTER=true

# Enable demo request form
NEXT_PUBLIC_ENABLE_DEMO=true

# Enable contact form
NEXT_PUBLIC_ENABLE_CONTACT=true

# -----------------------------------------------------------------------------
# Third-Party Integrations
# -----------------------------------------------------------------------------
# Add any additional third-party service credentials here
# Examples:

# Stripe (for payments)
# STRIPE_SECRET_KEY=your_stripe_secret_key_here
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Mailchimp (for newsletter management)
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us1
# MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx

# PostHog (for product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Database Configuration (if applicable)
# -----------------------------------------------------------------------------
# Add database connection strings if your application uses a database
# Examples:

# PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# MongoDB
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Redis (for caching/sessions)
# REDIS_URL=redis://user:password@host:6379
